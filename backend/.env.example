APP_NAME=AgentHQ
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://agenthq:agenthq@localhost:5432/agenthq
BACKEND_CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=replace-with-a-long-random-secret
BOOTSTRAP_SECRET=replace-with-a-separate-long-random-secret
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_BACKEND=console
EMAIL_FROM="AgentHQ <no-reply@agenthq.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Use SMTP_USE_SSL=true (and SMTP_USE_TLS=false) for implicit-TLS ports such as 465.
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
# EMAIL_BACKEND=resend sends through Resend's HTTPS API instead of SMTP (no SMTP_* needed).
# RESEND_API_KEY is a backend secret: never put it in a VITE_ variable or commit it.
RESEND_API_KEY=
RESEND_TIMEOUT_SECONDS=10
EMAIL_OUTBOX_WORKER_ENABLED=true
EMAIL_OUTBOX_POLL_SECONDS=5
EMAIL_OUTBOX_MAX_ATTEMPTS=6
IDENTITY_MIN_RESPONSE_MS=400
ALLOW_PUBLIC_REGISTRATION=false
# Real client IP header for IP rate limits behind a trusted edge (Render: cf-connecting-ip).
# Leave unset unless the ingress-spoofing test in DEPLOYMENT.md has passed.
TRUSTED_CLIENT_IP_HEADER=
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMITS_ENABLED=true
REDIS_URL=
SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60
INVITE_CREATE_RATE_LIMIT_ATTEMPTS=10
APPROVAL_RATE_LIMIT_ATTEMPTS=30
EXECUTION_RATE_LIMIT_ATTEMPTS=60
MCP_SYNC_RATE_LIMIT_ATTEMPTS=5
POLICY_DECISION_RATE_LIMIT_ATTEMPTS=60
COMPLIANCE_RATE_LIMIT_ATTEMPTS=30
ALLOW_PRIVATE_MCP_URLS=true
MCP_DISCOVERY_MODE=mock
GATEWAY_LIST_RATE_LIMIT_ATTEMPTS=60
GATEWAY_CALL_RATE_LIMIT_ATTEMPTS=30
GATEWAY_TOKEN_RATE_LIMIT_ATTEMPTS=10
# Real-mode credentials are referenced by MCP server auth_secret_ref, for example:
# MCP_AUTH_CUSTOMER_OPERATIONS=replace-with-secret
